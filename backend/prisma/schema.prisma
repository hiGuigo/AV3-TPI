generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id          String       @id @default(uuid())
  username    String       @unique
  senha       String
  permissao   Permissao
  createdAt   DateTime     @default(now())
  funcionario Funcionario?
  relatorios  Relatorio[]

  @@map("usuarios")
}

model Funcionario {
  id        String   @id @default(uuid())
  nome      String
  telefone  String?
  endereco  String?
  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  etapas    Etapa[]  @relation("EtapaToFuncionario")

  @@map("funcionarios")
}

model Aeronave {
  id         String       @id @default(uuid())
  codigo     String       @unique
  modelo     String
  capacidade Int
  alcance    Int
  tipo       TipoAeronave
  createdAt  DateTime     @default(now())
  etapas     Etapa[]
  pecas      Peca[]
  relatorios Relatorio[]
  testes     Teste[]

  @@map("aeronaves")
}

model Etapa {
  id           String        @id @default(uuid())
  nome         String
  prazo        DateTime
  status       StatusEtapa
  aeronaveId   String
  aeronave     Aeronave      @relation(fields: [aeronaveId], references: [id])
  funcionarios Funcionario[] @relation("EtapaToFuncionario")

  @@index([aeronaveId], map: "etapas_aeronaveId_fkey")
  @@map("etapas")
}

model Peca {
  id         String     @id @default(uuid())
  nome       String
  tipo       TipoPeca
  fornecedor String
  status     StatusPeca
  aeronaveId String
  aeronave   Aeronave   @relation(fields: [aeronaveId], references: [id])

  @@index([aeronaveId], map: "pecas_aeronaveId_fkey")
  @@map("pecas")
}

model Teste {
  id        String           @id @default(uuid())
  tipo      TipoTeste
  resultado testes_resultado
  createdAt DateTime         @default(now())

  aeronaveId String
  aeronave   Aeronave @relation(fields: [aeronaveId], references: [id])

  @@index([aeronaveId], map: "testes_aeronaveId_fkey")
  @@map("testes")
}

model Relatorio {
  id          String   @id @default(uuid())
  cliente     String
  dataEntrega DateTime
  texto       String
  aeronaveId  String
  autorId     String
  createdAt   DateTime @default(now())
  aeronave    Aeronave @relation(fields: [aeronaveId], references: [id])
  autor       Usuario  @relation(fields: [autorId], references: [id])

  @@index([aeronaveId], map: "relatorios_aeronaveId_fkey")
  @@index([autorId], map: "relatorios_autorId_fkey")
  @@map("relatorios")
}

enum Permissao {
  ADMIN
  ENGENHEIRO
  OPERADOR
}

enum TipoAeronave {
  COMERCIAL
  MILITAR
}

enum StatusEtapa {
  PENDENTE
  ANDAMENTO
  CONCLUIDA
}

enum TipoPeca {
  NACIONAL
  IMPORTADA
}

enum StatusPeca {
  EM_PRODUCAO
  EM_TRANSPORTE
  PRONTA
}

enum TipoTeste {
  ELETRICO
  HIDRAULICO
  AERODINAMICO
}

enum testes_resultado {
  PENDENTE
  APROVADO
  REPROVADO
}
