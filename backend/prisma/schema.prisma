// trecho responsável por definir como o prisma vai gerar o client
// nesse caso, em js/ts
// sem declarar o output, o padrão é "node_modules/.prisma/client"
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// aqui é apenas a declaração de qual banco irá ser utilizado
datasource db {
  provider = "mysql"
}

enum Permissao {
  ADMIN
  ENGENHEIRO
  OPERADOR
}

enum TipoAeronave {
  COMERCIAL
  MILITAR
}

enum StatusEtapa {
  PENDENTE
  ANDAMENTO
  CONCLUIDA
}

enum TipoPeca {
  NACIONAL
  IMPORTADA
}

enum StatusPeca {
  EM_PRODUCAO
  EM_TRANSPORTE
  PRONTA
}

enum TipoTeste {
  ELETRICO
  HIDRAULICO
  AERODINAMICO
}

enum ResultadoTeste {
  APROVADO
  REPROVADO
}

model Usuario {
  id          Int          @id @default(autoincrement())
  username    String       @unique
  senha       String
  permissao   Permissao

  funcionario Funcionario?
  relatorios  Relatorio[]

  createdAt   DateTime @default(now())

  @@map("usuarios")
}

model Funcionario {
  id          Int      @id @default(autoincrement())
  nome        String
  telefone    String?
  endereco    String?

  usuarioId   Int?     @unique
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])

  etapas      Etapa[]

  @@map("funcionarios")
}

model Aeronave {
  id          Int            @id @default(autoincrement())
  codigo      String         @unique
  modelo      String
  capacidade  Int
  alcance     Int
  tipo        TipoAeronave

  pecas       Peca[]
  etapas      Etapa[]
  testes      Teste[]
  relatorios  Relatorio[]

  createdAt   DateTime @default(now())

  @@map("aeronaves")
}

model Etapa {
  id            Int            @id @default(autoincrement())
  prazo         DateTime
  status        StatusEtapa

  aeronaveId    Int
  aeronave      Aeronave      @relation(fields: [aeronaveId], references: [id])

  funcionarios  Funcionario[]

  @@map("etapas")
}

model Peca {
  id           Int          @id @default(autoincrement())
  nome         String
  tipo         TipoPeca
  fornecedor   String
  status       StatusPeca

  aeronaveId   Int
  aeronave     Aeronave    @relation(fields: [aeronaveId], references: [id])

  @@map("pecas")
}

model Teste {
  id           Int              @id @default(autoincrement())
  tipo         TipoTeste
  resultado    ResultadoTeste

  aeronaveId   Int
  aeronave     Aeronave         @relation(fields: [aeronaveId], references: [id])

  @@map("testes")
}

model Relatorio {
  id            Int        @id @default(autoincrement())
  cliente       String
  dataEntrega   DateTime
  texto         String

  aeronaveId    Int
  aeronave      Aeronave  @relation(fields: [aeronaveId], references: [id])

  autorId       Int
  autor         Usuario   @relation(fields: [autorId], references: [id])

  createdAt     DateTime  @default(now())

  @@map("relatorios")
}